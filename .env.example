# Copy to .env and adjust. Compose falls back to these same defaults if
# a variable is unset, so for local dev the .env file is optional.
POSTGRES_USER=recitroc
POSTGRES_PASSWORD=recitroc
POSTGRES_DB=recitroc

# Signs JWT access tokens — anyone who knows it can forge a login for any
# user. The in-code dev default keeps `make dev` working without a .env,
# but set a real value here (openssl rand -hex 32) for anything shared.
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
